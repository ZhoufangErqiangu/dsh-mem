{
  "name": "@local/dsh-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "File-based project memory for DeepSeek Harness: a MEMORY.md index injected per session, plus memory_write, memory_read, and memory_search tools.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test 'tests/*.test.js'"
  }
}
